{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/favicon.svg",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/media/*.woff2",
          "/i18n/**"
        ]
      }
    },
    {
      "name": "content",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/puzzles/**", "/icons/**", "/licenses/**"]
      }
    }
  ]
}
